# 复制为 .env.local 并填入真实值;.env.local 已被 .gitignore 忽略,勿提交真实密钥。

# 数据库(PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# RSSHub;可换成自托管实例。feeds.url 保存 rsshub:// canonical URI,抓取时才解析到这里。
RSSHUB_BASE_URL=https://rsshub.app

# 登录(Auth.js Credentials,见 docs/product-design.md §8)
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=

# AI 配置不再从环境变量读取。
# 对话模型 / 向量模型的 baseURL、API Key、model 在设置页保存并写入 ai_configs 表。
