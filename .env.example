# ╔══════════════════════════════════════════════════════════╗
# ║  rsxonhub 环境变量配置模板                                ║
# ║                                                          ║
# ║  使用说明:                                                ║
# ║  1. 复制此文件为 .env.local                               ║
# ║  2. 填入真实值（不要提交到 Git）                           ║
# ║  3. Docker Compose 会自动加载 .env.local                  ║
# ╚══════════════════════════════════════════════════════════╝

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔐 认证配置 (必需)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# NextAuth.js 加密密钥 (必须设置)
# 生成命令: openssl rand -base64 32
AUTH_SECRET=

# 管理员账号
AUTH_USERNAME=admin
# 管理员密码 (明文，启动时自动哈希存储)
# 建议使用强密码：至少 16 位，包含大小写字母、数字、特殊字符
AUTH_PASSWORD=

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🗄️ 数据库配置 (必需)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# PostgreSQL 连接字符串
# 格式: postgresql://user:password@host:port/database
# 
# Docker Compose 示例:
# DATABASE_URL=postgresql://rsxonhub:${DB_PASSWORD}@db:5432/rsxonhub
#
# 本地开发示例:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/rsxonhub
#
# Railway/Render 等平台会自动提供此变量
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 📡 RSSHub 配置 (可选)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# RSSHub 实例地址
# - 使用公共实例: https://rsshub.app
# - 自托管实例: http://your-rsshub-server:1200
# - Docker Compose 中已包含 RSSHub 服务，可使用: http://rsshub:1200
RSSHUB_BASE_URL=http://rsshub:1200

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🌐 网络代理配置 (可选)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# RSS 抓取代理
# 如果某些 RSS 源需要代理访问，配置此项
# 格式: http://user:pass@proxy-host:port 或 socks5://...
RSS_FETCH_PROXY=

# AI 请求代理
# 如果 AI API 需要代理访问（例如在中国大陆）
# 支持 HTTP/HTTPS/SOCKS5 代理
AI_PROXY_URL=

# AI 请求超时时间 (毫秒)
# 默认 60 秒，可根据网络情况调整
AI_REQUEST_TIMEOUT_MS=60000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⏰ 每日精选调度配置 (可选)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 时区设置
# 常用时区: Asia/Shanghai, America/New_York, Europe/London
DIGEST_TIMEZONE=Asia/Shanghai

# 摘要生成时间 (HH:MM 格式)
# 在此时间点生成并发送每日精选
DIGEST_GENERATE_AT=08:00

# 摘要准备时间 (HH:MM 格式)
# 提前准备数据，确保准时生成
DIGEST_PREPARE_AT=07:30

# 触发窗口 (分钟)
# 在生成时间前后多少分钟内允许触发
DIGEST_TRIGGER_WINDOW_MINUTES=10

# 扫描间隔 (毫秒)
# 检查是否到达生成时间的频率
# 300000 = 5 分钟
DIGEST_SCAN_INTERVAL_MS=300000

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔧 其他配置 (可选)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Node 环境 (通常由部署平台自动设置)
# NODE_ENV=production

# 应用端口 (Docker 中通常不需要修改)
# PORT=3000

# 日志级别: error, warn, info, debug
# LOG_LEVEL=info
