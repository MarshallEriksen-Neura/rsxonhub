# 复制为 .env.local 并填入真实值;.env.local 已被 .gitignore 忽略,勿提交真实密钥。

# 数据库(PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 登录(Auth.js Credentials,见 docs/product-design.md §8)
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=
# 如需避免启动时哈希明文密码,也可改用 AUTH_PASSWORD_HASH 并删除 AUTH_PASSWORD
AUTH_PASSWORD_HASH=

# Chat / 摘要 / Digest(OpenAI 兼容)
OPENAI_BASE_URL=
OPENAI_API_KEY=
CHAT_MODEL=

# Embedding(NVIDIA,OpenAI 兼容)
# EMBEDDING_DIM 必须实测确认后填写,见 docs/product-design.md §6 坑 1
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_DIM=2048
