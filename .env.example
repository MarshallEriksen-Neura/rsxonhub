# 复制为 .env.local 并填入真实值;.env.local 已被 .gitignore 忽略,勿提交真实密钥。

# 数据库(PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# RSSHub;可换成自托管实例。feeds.url 保存 rsshub:// canonical URI,抓取时才解析到这里。
# 可填完整 URL,也可填裸域名(裸域名会按 https:// 处理)。
RSSHUB_BASE_URL=http://rsshub:1200

# RSS 抓取代理
RSS_FETCH_PROXY=
# AI 出站请求代理;支持 http://user:pass@host:port,HTTPS 模型端点会通过 CONNECT 隧道。
AI_PROXY_URL=
AI_REQUEST_TIMEOUT_MS=60000

# 登录(Auth.js Credentials,见 docs/product-design.md §8)
AUTH_SECRET=
AUTH_USERNAME=
AUTH_PASSWORD=


# 每日精选调度
DIGEST_TIMEZONE=Asia/Shanghai
DIGEST_GENERATE_AT=08:00
DIGEST_PREPARE_AT=07:30
DIGEST_TRIGGER_WINDOW_MINUTES=10
DIGEST_SCAN_INTERVAL_MS=300000
